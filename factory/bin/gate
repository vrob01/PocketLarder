#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch adds, modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`).

checks.sh waits for GitHub's Mac build on branches that touch ios/. The hook
can't wait that long, so it skips the wait. The merge gate runs on a local merge
commit GitHub never built, so it relies on the build of the commit the round
gated, and fails when the merge brought in ios/ changes that build didn't see.
"""

import fnmatch
import json
import os
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Files under protected_paths that the branch added, modified or deleted."""
    # -z leaves odd file names unquoted; --no-renames reports both sides of a rename.
    diff = git(worktree, "diff", "--name-status", "--no-renames", "-z", f"origin/{CONFIG['base_branch']}...HEAD")
    fields = diff.split("\0")
    return [f"{status} {path}" for status, path in zip(fields[0::2], fields[1::2])
            if any(fnmatch.fnmatch(path, pattern) for pattern in CONFIG["protected_paths"])]


def unbuilt_app_changes(worktree, gated):
    """ios/ paths the merge added to a branch that needs a Mac build, since the commit that got one."""
    def ios_paths(revisions):
        out = git(worktree, "diff", "--name-only", "--no-renames", "-z", revisions)
        return [p for p in out.split("\0") if p.startswith("ios/")]
    if not ios_paths(f"origin/{CONFIG['base_branch']}...HEAD"):
        return []
    return ios_paths(f"{gated}..HEAD")


def run_checks(worktree, **env):
    start = time.monotonic()
    res = subprocess.run(["bash", str(CHECKS)], cwd=worktree, capture_output=True, text=True,
                         env={**os.environ, **env})
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    if merge:
        lines = (round_dir / "checks.md").read_text().splitlines()
        gated = next((l.removeprefix("COMMIT: ") for l in lines if l.startswith("COMMIT: ")), "")
        if not gated:
            die(f"round-{job['round']}/checks.md names no gated commit")
        unbuilt = unbuilt_app_changes(worktree, gated)
        if unbuilt:
            code, log, seconds = 1, ("main changed ios/ since the gate: merge origin/main, push, and gate again.\n"
                                     + "\n".join(unbuilt) + "\n"), 0
        else:
            code, log, seconds = run_checks(worktree, FACTORY_CI_COMMIT=gated)
    else:
        code, log, seconds = run_checks(worktree)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    code, log, _ = run_checks(job["worktree"], FACTORY_SKIP_CI="1")
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
