      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden löschen"
          }
        }
      }
    },
    "Delete %@? Its categories go too. Entries filed there move to Not filed yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löschen? Die Kategorien dieses Ladens werden mitgelöscht. Einträge, die dort einsortiert sind, kommen zu „Noch nicht einsortiert“."
          }
        }
      }
    },
    "Search items": {
      "localizations": {
        "de": {
