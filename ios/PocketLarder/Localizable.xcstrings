      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden hinzufügen"
          }
        }
      }
    },
    "Drag ≡ to match your round trip. Tap a store to rename it, delete it, or sort its categories the way you walk through it. Deleting a store keeps its entries under \"Not filed yet\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh ≡, bis die Reihenfolge zu deiner Runde passt. Tippe auf einen Laden, um ihn umzubenennen, zu löschen oder seine Kategorien so zu sortieren, wie du durch ihn gehst. Wenn du einen Laden löschst, bleiben seine Einträge unter „Noch nicht einsortiert“."
          }
        }
      }
    },
    "New store": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Laden"
          }
        }
      }
    },
    "Categories": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien"
          }
        }
      }
    },
