{
  "sourceLanguage": "en",
  "strings": {
    "Shopping lists for your household. To start, this iPhone needs an invite from someone in your household: scan its QR code with the Camera app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkaufslisten für deinen Haushalt. Zum Start braucht dieses iPhone eine Einladung von jemandem aus deinem Haushalt: Scanne den QR-Code mit der Kamera-App."
          }
        }
      }
    },
    "Open source and private. No tracking, no ads, no analytics. Your lists are stored only on your household's own server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source und privat. Kein Tracking, keine Werbung, keine Analysen. Deine Listen liegen nur auf dem eigenen Server deines Haushalts."
          }
        }
      }
    },
    "Enter invite": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung eingeben"
          }
        }
      }
    },
    "Set up your own server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigenen Server einrichten"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        }
      }
    },
    "Invite code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladungscode"
          }
        }
      }
    },
    "Device name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätename"
          }
        }
      }
    },
    "Sign in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        }
      }
    },
    "Shows in your household's device list, e.g. \"Sam's iPhone\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint in der Geräteliste deines Haushalts, z. B. „Sams iPhone“."
          }
        }
      }
    },
    "Got the invite as one link? Tap Paste and the fields fill themselves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du die Einladung als einen Link bekommen? Tippe auf Einsetzen und die Felder füllen sich von selbst."
          }
        }
      }
    },
    "lists.example.com": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "lists.example.com"
          }
        }
      }
    },
    "from your invite": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "aus deiner Einladung"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "This invite can't be used. It may have expired or been used already. Ask for a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einladung kann nicht verwendet werden. Vielleicht ist sie abgelaufen oder wurde schon benutzt. Bitte um eine neue."
          }
        }
      }
    },
    "Too many sign-in attempts on this server. Try again in a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche auf diesem Server. Versuch es in einer Minute noch einmal."
          }
        }
      }
    },
    "Can't reach %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar."
          }
        }
      }
    },
    "Couldn't sign in. Try again, or ask for a new invite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat nicht geklappt. Versuch es noch einmal oder bitte um eine neue Einladung."
          }
        }
      }
    },
    "This iPhone is already signed in as %@. Sign out first to use this invite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone ist schon als %@ angemeldet. Melde dich zuerst ab, um diese Einladung zu verwenden."
          }
        }
      }
    },
    "This iPhone was signed out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone wurde abgemeldet."
          }
        }
      }
    },
    " %lld changes that weren't sent yet are lost.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld Änderung, die noch nicht gesendet wurde, ist verloren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld Änderungen, die noch nicht gesendet wurden, sind verloren."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld change that wasn't sent yet is lost."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld changes that weren't sent yet are lost."
                }
              }
            }
          }
        }
      }
    },
    "%lld changes haven't been sent yet. Sign out and lose them?": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Änderung wurde noch nicht gesendet. Abmelden und sie verlieren?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Änderungen wurden noch nicht gesendet. Abmelden und sie verlieren?"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change hasn't been sent yet. Sign out and lose it?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes haven't been sent yet. Sign out and lose them?"
                }
              }
            }
          }
        }
      }
    },
    "Can't reach your server. Sign out anyway? This deletes everything on this iPhone. Ask an admin to remove this device from the household.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist nicht erreichbar. Trotzdem abmelden? Das löscht alles auf diesem iPhone. Bitte einen Admin, dieses Gerät aus dem Haushalt zu entfernen."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "Sign out anyway": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem abmelden"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "My account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Konto"
          }
        }
      }
    },
    "My view": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ansicht"
          }
        }
      }
    },
    "My list": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Liste"
          }
        }
      }
    },
    "%@'s list": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste von %@"
          }
        }
      }
    },
    "%@, read-only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, schreibgeschützt"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle"
          }
        }
      }
    },
    "Not filed yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht einsortiert"
          }
        }
      }
    },
    "Recently bought (%lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzlich gekauft (%lld)"
          }
        }
      }
    },
    "Expanded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgeklappt"
          }
        }
      }
    },
    "Collapsed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugeklappt"
          }
        }
      }
    },
    "Put back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück auf die Liste"
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Artikel"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Artikel"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        }
      }
    },
    "Add item…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikel hinzufügen…"
          }
        }
      }
    },
    "%@'s list is read-only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste von %@ ist schreibgeschützt."
          }
        }
      }
    },
    "%@'s list is now hidden, so it's no longer on this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste von %@ ist jetzt ausgeblendet und deshalb nicht mehr auf diesem iPhone."
          }
        }
      }
    },
    " Your recent changes to it weren't saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Deine letzten Änderungen daran wurden nicht gespeichert."
          }
        }
      }
    },
    "%@'s list is now read-only. Your recent changes to it weren't saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste von %@ ist jetzt schreibgeschützt. Deine letzten Änderungen daran wurden nicht gespeichert."
          }
        }
      }
    },
    "Couldn't rename \"%@\" to \"%@\": that item already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ konnte nicht in „%2$@“ umbenannt werden: Diesen Artikel gibt es schon."
          }
        }
      }
    },
    "Cross off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhaken"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        }
      }
    },
    "Quantity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menge"
          }
        }
      }
    },
    "Note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiz"
          }
        }
      }
    },
    "%@ answered with error code %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mit dem Fehlercode %2$@ geantwortet."
          }
        }
      }
    },
    "%@ answered with HTTP status %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mit dem HTTP-Status %2$lld geantwortet."
          }
        }
      }
    },
    "No changes are waiting to be sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es warten keine Änderungen darauf, gesendet zu werden."
          }
        }
      }
    },
    "%lld changes are waiting to be sent.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Änderung wartet darauf, gesendet zu werden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Änderungen warten darauf, gesendet zu werden."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change is waiting to be sent."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes are waiting to be sent."
                }
              }
            }
          }
        }
      }
    },
    "Can't sync": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisieren nicht möglich"
          }
        }
      }
    },
    "%@ is already on this list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steht schon auf dieser Liste."
          }
        }
      }
    },
    "Couldn't save this change on this iPhone: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung konnte auf diesem iPhone nicht gespeichert werden: %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}